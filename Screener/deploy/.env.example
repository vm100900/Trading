# Copy to `.env` and fill in. `.env` is gitignored — keep the real secrets there.

# ── App API ────────────────────────────────────────────────────────────────
# Bearer token every REST/WS call from the app must send. Generate one:
#   openssl rand -hex 32
SCREENER_AUTH_TOKEN=change-me

# Public domain Caddy will get a TLS cert for and reverse-proxy to the service.
# Point its DNS A/AAAA record at this server first.
SCREENER_DOMAIN=screener.example.com

# ── IBKR ───────────────────────────────────────────────────────────────────
TWS_USERID=your_ibkr_username
TWS_PASSWORD=your_ibkr_password
TRADING_MODE=paper                 # paper | live   (start with paper — no 2FA)
READ_ONLY_API=yes                  # screener only pulls market data

# Which forwarded Gateway port the service dials:
#   ib-gateway:4004  paper      ib-gateway:4003  live
SCREENER_IBKR_ADDR=ib-gateway:4004
SCREENER_IBKR_CLIENT_ID=11

# Gateway auto-restarts once a day (IBKR requirement). Keep screening runs
# away from this time. Format is IBC's, e.g. "11:59 PM".
IBKR_AUTO_RESTART_TIME=11:59 PM

# ── Misc ───────────────────────────────────────────────────────────────────
RUST_LOG=info,screener_core=debug

# Set to 1 to ignore Yahoo/IBKR entirely and stream a scripted fake run
# (useful to prove the app <-> API <-> TLS path before wiring IBKR).
SCREENER_DEMO_ENGINE=
